<resources>
    <!-- Shown by the system before the first frame: midnight-navy with the Choropia mark.
         The in-app animated loader (BrandLoader) takes over seamlessly from here. -->
    <style name="Theme.Choropia.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/choropia_navy</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.Choropia</item>
    </style>

    <style name="Theme.Choropia" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/choropia_navy</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
