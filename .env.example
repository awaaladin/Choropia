# Copy this file to .env and fill in real values. Never commit the real .env.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# postgres://USER:PASSWORD@HOST:PORT/NAME  (leave unset to fall back to sqlite for quick local runs)
DATABASE_URL=postgres://choropia:choropia@db:5432/choropia

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

CORS_ALLOWED_ORIGINS=http://localhost:3000

JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=14

# Gaxtron (crypto escrow payments — see payments/gaxtron.py)
GAXTRON_API_KEY=
GAXTRON_BASE_URL=http://127.0.0.1:9000
GAXTRON_WEBHOOK_SECRET=
GAXTRON_NGN_PER_USD=1600
GAXTRON_CALLBACK_URL=https://httpbin.org/post

ESCROW_AUTO_RELEASE_DAYS=3
PLATFORM_PILOT_CITY=Uyo

DELIVERY_PROVIDER=delivery.providers.mock.MockDeliveryProvider

# S3-compatible object storage (leave USE_S3=false to use local disk for dev)
USE_S3=false
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=eu-west-1

# Email (used for password-reset links). Dev default is fine for local testing — the link
# prints to the runserver console instead of actually sending.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Choropia <no-reply@choropia.local>
PASSWORD_RESET_URL_BASE=http://localhost:8000/reset-password/
